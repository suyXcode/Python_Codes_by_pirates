    "# second \n",
    "def getLcm(a, b, c):\n",
    "    i=1 \n",
    "    while True:\n",
    "        if i%a==0 and i%b==0 and i%c==0:\n",
    "            return i\n",
    "        i+=1\n",
    "print(getLcm(4, 6, 8))"

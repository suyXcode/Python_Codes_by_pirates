   "outputs": [],
   "source": [
    "# Get Lcm of three Numbers.\n",
    "\n",
    "def getLcm(a, b, c):\n",
    "    lcm = (a * b * c) // (gcd(a, gcd(b, c)))\n",
    "    return lcm"
   ]
  },

    "# Valid Parentheses\n",
    "def isvalid(s):\n",
    "    stack=[]\n",
    "    mapping={')':'(',']':'[','}':'{'}\n",
    "    for char in s:\n",
    "        if char in mapping:\n",
    "            top = stack.pop() if stack else '#'\n",
    "            if mapping[char]!=top:\n",
    "                return False\n",
    "            else:\n",
    "                stack.append(char)\n",
    "    return not stack\n",
    "print(isvalid(\"()[]{}\"))\n"
   ]
